# Production-like local simulation via Podman.
POSTGRES_PASSWORD=propfirm

PROPFIRM_SERVER__BIND_ADDR=0.0.0.0:8080
PROPFIRM_SERVER__TLS__ENABLED=false
PROPFIRM_POSTGRES__DSN=postgresql://propfirm:${POSTGRES_PASSWORD}@postgres:5432/propfirm
PROPFIRM_POSTGRES__MAX_CONNECTIONS=50
PROPFIRM_POSTGRES__RUN_MIGRATIONS=true
PROPFIRM_POSTGRES__ACQUIRE_TIMEOUT_SECS=15
PROPFIRM_REDIS__URL=redis://redis:6379
PROPFIRM_REDIS__CLUSTER=false
PROPFIRM_IDEMPOTENCY__BACKEND=redis
PROPFIRM_IDEMPOTENCY__TTL_SECS=604800
PROPFIRM_OBSERVABILITY__LOG_FORMAT=json
PROPFIRM_OBSERVABILITY__LOG_FILTER=info,propfirm=info,sqlx=warn,redis=warn
PROPFIRM_OBSERVABILITY__METRICS_ENABLED=true
PROPFIRM_OBSERVABILITY__PANIC_HOOK=true
