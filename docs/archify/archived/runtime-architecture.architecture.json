  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "Response carries account_state, input_hash, and events for the caller to persist",
        "Overrides and emergency-stop emit events on PipelineResult.events",
        "GET /health and GET /ready are the only unauthenticated routes"
      ]
    },
    {
      "dot": "emerald",
      "title": "Stateless core (ADR-11)",
      "items": [
        "No account database: the caller sends account_state with every request",
        "input_hash commits to account_state, rule pack, and inputs so verdicts are replay-auditable",
        "Rule packs are JSON data, validated at /v1/rule-packs/validate"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "auth_layer fails closed: 401 without credentials, 403 on tenant mismatch",
        "Service tokens gate /internal/* routes; tenant keys gate /v1/* routes",
        "EventStore and Notifier are pluggable seams; LogNotifier is the default sink"
      ]
    }
  ]
}
