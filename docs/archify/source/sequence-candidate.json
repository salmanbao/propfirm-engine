    {
      "dot": "emerald",
      "title": "Happy Path",
      "items": [
        "Order request flows through API router to pipeline",
        "Evaluator returns PureVerdict deterministically",
        "Response includes decision, violations, and input_hash"
      ]
    },
    {
      "dot": "violet",
      "title": "Auth + Isolation",
      "items": [
        "Service/tenant key validated before evaluation",
        "Cross-tenant requests rejected with 403",
        "Stateless: no server-side account store"
      ]
    },
    {
      "dot": "orange",
      "title": "Observability",
      "items": [
        "Violations trigger async notifications",
        "Events returned in PipelineResult for caller persistence",
        "input_hash enables byte-for-byte replay"
      ]
    }
